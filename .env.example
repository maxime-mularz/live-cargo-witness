# Copy to .env and fill in. Never commit .env.
# Muse Spark Open on Baseten (orchestration and document reading)
BASETEN_API_KEY=
# LCW_OPEN_BASE_URL=https://inference.baseten.co/v1
# LCW_OPEN_MODEL=meta-models/muse-spark-open-1026
# Meta Model API (SAM 3.1, Muse Voice Transcribe, Muse Spark). MODEL_API_KEY also works.
META_MODEL_API_KEY=
# LCW_META_BASE_URL=https://api.meta.ai/v1
# LCW_SPARK_MODEL=muse-spark-1.3
# open (Muse Spark Open orchestrates, default) or spark (fallback if CA-02 fails)
# LCW_ORCHESTRATOR=open
# LCW_REASONING_EFFORT=
# Optional, for the CA-12 cost estimate: per model, [USD per million input tokens, per million output tokens]
# LCW_PRICES={"meta-models/muse-spark-open-1026": [0.0, 0.0]}
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
TIVE_API_KEY=
